# shell.nix by poligle
#
# NIHIL shell on Quickshell: frame and bar, drawers (dashboard, control
# panel, launcher), notifications, OSD and desktop widgets. It replaces
# waybar, wofi, eww and dunst.
#
# The QML lives in home/shell/. Tokens.qml and Config.qml are generated here
# from theme/nihil.nix and the host outputs, and every external program is
# referenced by its store path, so the shell does not depend on $PATH.
#
#   nihil-ipc drawers toggle launcher|dashboard|panel
#   nihil-ipc osd volume 40 false        nihil-ipc glyph test true
#   nihil-ipc nilo toggle                (Nilo, modules/nilo.nix)
#   nihil-ipc settings open|toggle|close|welcome|wallpapers (Preferences, settings/)
#   journalctl --user -u nihil-shell -f  (logs)

{ config, osConfig, pkgs, lib, ... }:
let
	nihil = osConfig.nihil;
	t = nihil.tokens;
	quickshell = pkgs.quickshell;
	profile = "${config.home.profileDirectory}/bin";
	iconTheme = config.gtk.iconTheme.name;

	# Nilo (modules/nilo.nix): the shell starts the agent when it first opens.
	nilo =
	{
		enabled = nihil.nilo.enable;
		agent = lib.optionalString nihil.nilo.enable "${import ./nilo { inherit pkgs lib osConfig; inherit (commands) terminal; }}/bin/nilo-agent";
	};

	tokensQml = pkgs.writeText "Tokens.qml" ''
		pragma Singleton

		import QtQuick
		import Quickshell

		// Generated by home/shell.nix from theme/nihil.nix: edit the tokens there.
		Singleton {
		    readonly property color black: "#${t.palette.void}"
		    readonly property color surface: "#${t.palette.surface}"
		    readonly property color raised: "#${t.palette.raised}"
		    readonly property color line: "#${t.palette.line}"
		    readonly property color off: "#${t.palette.off}"
		    readonly property color muted: "#${t.palette.muted}"
		    readonly property color dim: "#${t.palette.dim}"
		    readonly property color ink: "#${t.palette.ink}"
		    readonly property color interrupt: "#${t.palette.signal}"

		    // An old google-fonts snapshot may lack Doto: fall back to Space Mono.
		    readonly property string fontDot: Qt.fontFamilies().indexOf("${t.fonts.dot}") >= 0 ? "${t.fonts.dot}" : "${t.fonts.mono}"
		    readonly property string fontSans: "${t.fonts.sans}"
		    readonly property string fontMono: "${t.fonts.mono}"
		    readonly property string fontIcons: "${t.fonts.icons}"

		    readonly property int frameThickness: ${toString t.frame.thickness}
		    readonly property int barWidth: ${toString t.frame.bar}
		    readonly property int frameRadius: ${toString t.frame.radius}
		    readonly property int fillet: ${toString t.frame.fillet}
		    readonly property int drawerRadius: ${toString t.frame.drawerRadius}

		    readonly property int animFast: ${toString t.motion.fast}
		    readonly property int animNormal: ${toString t.motion.normal}
		    readonly property int animDrawer: ${toString t.motion.drawer}
		    readonly property int animSlow: ${toString t.motion.slow}
		}
	'';

	# Raw ASCII output for the dashboard visualiser: "3;5;0;...;\n" per frame.
	cavaConfig = pkgs.writeText "nihil-cava.conf" (lib.generators.toINI { }
	{
		general = { bars = 24; framerate = 30; autosens = 1; };
		input = { method = "pipewire"; source = "auto"; };
		output =
		{
			method = "raw";
			raw_target = "/dev/stdout";
			data_format = "ascii";
			ascii_max_range = 6;
			bar_delimiter = 59;
			frame_delimiter = 10;
		};
		smoothing.noise_reduction = 70;
	});

	commands =
	{
		sh = "${pkgs.bash}/bin/sh";
		nmcli = "${pkgs.networkmanager}/bin/nmcli";
		nmEditor = "${pkgs.networkmanagerapplet}/bin/nm-connection-editor";
		notifySend = "${pkgs.libnotify}/bin/notify-send";
		brightnessctl = "${pkgs.brightnessctl}/bin/brightnessctl";
		pwPlay = "${pkgs.pipewire}/bin/pw-play";
		rfkill = "${pkgs.util-linux}/bin/rfkill";
		hyprsunset = "${pkgs.hyprsunset}/bin/hyprsunset";
		ip = "${pkgs.iproute2}/bin/ip";
		cava = "${pkgs.cava}/bin/cava";
		qalc = "${pkgs.libqalculate}/bin/qalc";
		wlCopy = "${pkgs.wl-clipboard}/bin/wl-copy";
		systemctl = "${pkgs.systemd}/bin/systemctl";
		uwsm = "${osConfig.programs.uwsm.package}/bin/uwsm";
		pavucontrol = "${pkgs.pavucontrol}/bin/pavucontrol";
		blueman = "${pkgs.blueman}/bin/blueman-manager";
		terminal = "${profile}/kitty";
		lock = "${profile}/lock-screen";
		powerOff = "${profile}/power-off";
		micLedSync = "${profile}/mic-led-sync";
		wallpaper = "${profile}/nihil-wallpaper";
		# Preferences applies through sudo and nihil apply (modules/nihil-cli.nix).
		sudo = "/run/wrappers/bin/sudo";
		nihil = "/run/current-system/sw/bin/nihil";
		timedatectl = "${pkgs.systemd}/bin/timedatectl";
	};

	sounds =
	{
		menu = "${nihil.sounds.menu}";
		notify = "${nihil.sounds.notify}";
		critical = "${nihil.sounds.critical}";
		charge = "${nihil.sounds.charge}";
	};

	configQml = pkgs.writeText "Config.qml" ''
		pragma Singleton

		import Quickshell

		// Generated by home/shell.nix from the host outputs (modules/nihil.nix).
		Singleton {
		    readonly property var barOutputs: ${builtins.toJSON (builtins.attrNames (lib.filterAttrs (_: output: output.bar) nihil.outputs))}
		    readonly property string primaryOutput: "${nihil.primaryOutput}"
		    readonly property int persistentWorkspaces: 3
		    readonly property var widgets: ${builtins.toJSON [ "clock" "network" "media" ]}
		    readonly property var trayHidden: ${builtins.toJSON nihil.trayHidden}
		    readonly property var wallpapers: ${builtins.toJSON nihil.wallpapers.names}
		    readonly property string cavaConfig: "${cavaConfig}"
		    readonly property var sounds: (${builtins.toJSON sounds})
		    readonly property var cmd: (${builtins.toJSON commands})
		    readonly property var nilo: (${builtins.toJSON nilo})

		    // Preferences (settings/): the machine's settings.json, the wallpaper
		    // renders, and the keys and fingers as built and as NIHIL has them.
		    readonly property string settingsFile: "${nihil.flake}/settings.json"
		    readonly property string wallpaperDir: "${nihil.wallpapers}"
		    readonly property string user: "${nihil.user.name}"
		    readonly property var binds: (${builtins.toJSON nihil.binds})
		    readonly property var bindDefaults: (${builtins.toJSON nihil.bindDefaults.keys})
		    readonly property var gestureDefaults: (${builtins.toJSON nihil.bindDefaults.gestures})
		    readonly property var programs: (${builtins.toJSON nihil.programs})
		}
	'';

	# Strings of the selected language (theme/i18n.nix), as QML string literals.
	langQml = pkgs.writeText "Lang.qml" ''
		pragma Singleton

		import Quickshell

		// Generated by home/shell.nix from theme/i18n.nix (nihil.language = "${nihil.language}").
		Singleton {
		${lib.concatStringsSep "\n" (lib.mapAttrsToList (key: text: "    readonly property string ${key}: ${builtins.toJSON text}") nihil.strings)}
		}
	'';

	shell = pkgs.runCommand "nihil-shell" { } ''
		cp -r ${./shell} $out
		chmod -R u+w $out
		mkdir -p $out/config
		cp ${tokensQml} $out/theme/Tokens.qml
		cp ${configQml} $out/config/Config.qml
		cp ${langQml} $out/config/Lang.qml
		substituteInPlace $out/shell.qml --replace-fail "@ICON_THEME@" "${iconTheme}"
	'';

	nihil-ipc = pkgs.writeShellScriptBin "nihil-ipc" ''
		exec ${quickshell}/bin/qs -c nihil ipc call "$@"
	'';
in
{
	home.packages =
	[
		quickshell
		nihil-ipc
	];

	xdg.configFile."quickshell/nihil".source = shell;

	systemd.user.services.nihil-shell =
	{
		Unit =
		{
			Description = "NIHIL shell (Quickshell)";
			After = [ "graphical-session.target" ];
			PartOf = [ "graphical-session.target" ];
			# A new build of the shell restarts the service on switch.
			X-Restart-Triggers = [ "${shell}" ];
		};

		Service =
		{
			ExecStart = "${quickshell}/bin/qs -c nihil";
			Restart = "on-failure";
			RestartSec = 2;
			# Apps opened from the launcher live in this cgroup: keep them
			# running when the shell restarts.
			KillMode = "process";
			# They also inherit this environment, so it only adds what Hyprland
			# gives the apps it starts (home/session-env.nix). PATH stays the
			# session's; the shell's own settings are pragmas in shell.qml.
			Environment = lib.mapAttrsToList (name: value: "${name}=${value}") (import ./session-env.nix);
		};

		Install.WantedBy = [ "graphical-session.target" ];
	};
}
