//@ pragma UseQApplication
//@ pragma IconTheme @ICON_THEME@
//@ pragma Env QT_QPA_PLATFORM=wayland
//@ pragma Env QSG_DISTANCEFIELD_ANTIALIASING=gray

// NIHIL — ex nihilo.
// Entry point of the Quickshell configuration. Tokens.qml, Config.qml and
// Lang.qml are generated by home/shell.nix; everything else lives next to
// this file. The pragmas only change the shell's own process, not the
// environment of the apps it opens. Text is antialiased in grey: subpixel
// antialiasing tints the thin glyphs and the dots of Doto blue and orange.

import QtQuick
import Quickshell
import qs.services
import qs.frame
import qs.background
import qs.settings

ShellRoot {
    // Singletons are created on first use; touch the ones that must run from
    // the start: notification server, IPC handlers, the battery watcher and the
    // settings (the welcome, the first time).
    readonly property var services: [Drawers, Osd, Glyph, Notifs, Battery, Audio, Network, Bt, Nilo, Machine]

    Variants {
        model: Quickshell.screens

        Frame {}
    }

    Desktop {}

    Preferences {}
}
