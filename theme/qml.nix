# qml.nix by poligle

{ pkgs, lib, nihil }:
let
	t = nihil.tokens;
in
{
	tokens = pkgs.writeText "Tokens.qml" ''
		pragma Singleton

		import QtQuick
		import Quickshell

		// Generated by theme/qml.nix from theme/nihil.nix: edit the tokens there.
		Singleton {
		    readonly property color black: "#${t.palette.void}"
		    readonly property color surface: "#${t.palette.surface}"
		    readonly property color raised: "#${t.palette.raised}"
		    readonly property color line: "#${t.palette.line}"
		    readonly property color off: "#${t.palette.off}"
		    readonly property color muted: "#${t.palette.muted}"
		    readonly property color dim: "#${t.palette.dim}"
		    readonly property color ink: "#${t.palette.ink}"
		    readonly property color interrupt: "#${t.palette.signal}"

		    readonly property string fontDot: Qt.fontFamilies().indexOf("${t.fonts.dot}") >= 0 ? "${t.fonts.dot}" : "${t.fonts.mono}"
		    readonly property string fontSans: "${t.fonts.sans}"
		    readonly property string fontMono: "${t.fonts.mono}"
		    readonly property string fontIcons: "${t.fonts.icons}"

		    readonly property int frameThickness: ${toString t.frame.thickness}
		    readonly property int barWidth: ${toString t.frame.bar}
		    readonly property int frameRadius: ${toString t.frame.radius}
		    readonly property int fillet: ${toString t.frame.fillet}
		    readonly property int drawerRadius: ${toString t.frame.drawerRadius}

		    readonly property int animFast: ${toString t.motion.fast}
		    readonly property int animNormal: ${toString t.motion.normal}
		    readonly property int animDrawer: ${toString t.motion.drawer}
		    readonly property int animSlow: ${toString t.motion.slow}
		}
	'';

	lang = pkgs.writeText "Lang.qml" ''
		pragma Singleton

		import Quickshell

		// Generated by theme/qml.nix from theme/i18n.nix (nihil.language = "${nihil.language}").
		Singleton {
		${lib.concatStringsSep "\n" (lib.mapAttrsToList (key: text: "    readonly property string ${key}: ${builtins.toJSON text}") nihil.strings)}
		}
	'';
}
